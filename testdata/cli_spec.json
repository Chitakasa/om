  "core": {
   "args": [
    {
     "action": "_StoreAction",
     "choices": [
      "start",
      "stop",
      "restart",
      "reload",
      "update",
      "heal",
      "watch",
      "status"
     ],
     "default": "status",
     "dest": "action",
     "flags": [],
     "help": "What to do with the core (default: status)",
     "nargs": "?",
     "required": false
    },
    {
     "action": "_StoreAction",
     "choices": null,
     "default": null,
     "dest": "services",
     "flags": [],
     "help": "with restart: only these core containers (caddy, router, egress, sockguard, dashboard)",
     "nargs": "*",
     "required": false
    }
   ],
   "description": "actions:\n  status    core containers and the addresses they answer on (default)\n  start     start the core: resolve om.env (LAN, VPN, ports), write its config, create the containers\n  stop      stop the core; the self-heal timer leaves it stopped until `om core start`\n  restart   whole core: re-detect LAN/VPN addresses, rewrite its config, recreate every container\n            and re-attach them to the workspace networks (a few seconds of downtime)\n  restart <names>\n            only those containers, as they are (no re-detection), e.g. `om core restart router dashboard`\n  reload    drop routes of deleted workspaces and hot-reload the edge's routes (no downtime)\n  update    pull the core's pinned images and recreate what changed\n  heal      what the self-heal timer runs: revive dead containers, restart on address changes\n  watch     Linux, local engine: restart a container the moment its process dies unseen",
   "help": "Manage the Global Core (edge, router, dashboard)",
   "prog": "om core",
   "sub": {}
  },

podman run --rm --network demo_net --read-only --cap-drop ALL  python3 -c \nimport socket, sys\n\ndef probe(host, port, timeout=2.0):\n    try:\n        ip = socket.gethostbyname(host)\n    except OSError:\n        return "unreachable"\n    s = socket.socket()\n    s.settimeout(timeout)\n    try:\n        s.connect((ip, port))\n        return "open"\n    except ConnectionRefusedError:\n        return "refused"\n    except OSError:\n        return "unreachable"\n    finally:\n        s.close()\n\nresults = [probe(h, int(p)) for h, p in [arg.split(":") for arg in sys.argv[1:]]]\nprint(" ".join(results))\n om_stream_edge:22000 om_stream_router:1

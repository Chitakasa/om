# ── Global Core ─────────────────────────────────────────────────────────────

def ensure_core_running(runtime: str, ws_id: str | None = None):
    """Make sure the core is up and the router can reach every workspace network."""
    wids = set(get_known_workspaces()) | ({ws_id} if ws_id else set())
    if not core.core_running(runtime):
        print("\033[1m🌐 Starting Global Core (edge proxy, router, dashboard)...\033[0m")
        if not core.core_up(runtime):
            die("Global Core failed to start — run `om doctor` for a diagnosis.")
        print(f"  \033[32m✓ Dashboard online at {core.base_url()}/\033[0m")
    for net in core.connect_router(runtime, wids):
        print(f"\033[33m⚠ Could not attach to {net}\033[0m")
    for d in core.runtime_drift(runtime):
        print(f"\033[33m⚠ {d}\033[0m")

def _core_start(runtime: str, args):
    print("\033[1m🚀 Starting Global Core...\033[0m")
    if not core.core_up(runtime):
        sys.exit(1)
    prune_orphan_routes(runtime)
    print(f"\033[32m✓ Global Core is live: {core.base_url()}/\033[0m")

def _core_stop(runtime: str, args):
    print("\033[1m🛑 Stopping Global Core...\033[0m")
    core.core_down(runtime)
    print("\033[32m✓ Global Core stopped.\033[0m")

def _core_restart_containers(runtime: str, names: list[str]):
    """Restart only these core containers, as they are (no address re-detection)."""
    names = ["om_" + n.removeprefix("om_") for n in names]
    bad = [n for n in names if n not in core.CORE_CONTAINERS]
    if bad:
        die(f"Unknown core container(s): {', '.join(bad)} (known: {', '.join(k[3:] for k in core.CORE_CONTAINERS)})")
    # engine_lifecycle: on local Podman om first matches the healthcheck timers' oom_score_adj
    run(core.engine_lifecycle(runtime, "restart", *names), capture_output=False)
    down = [n for n in names if not core.container_running(runtime, n)]
    if down:  # a runtime hiccup (e.g. conmon killed) can leave it exited: start it once
        run(core.engine_lifecycle(runtime, "start", *down), capture_output=False)
        down = [n for n in down if not core.container_running(runtime, n)]
    if down:
        die(f"Could not bring up {', '.join(down)} — see `{runtime} logs {down[0]}`.")
    print(f"\033[32m✓ Restarted {', '.join(names)}.\033[0m")

def _core_restart(runtime: str, args):
    if args.services:
        _core_restart_containers(runtime, args.services)
        return
    print("\033[1m🔄 Restarting Global Core...\033[0m")
    if not core.core_up(runtime, recreate=True):
        sys.exit(1)
    prune_orphan_routes(runtime)
    print("\033[32m✓ Global Core restarted.\033[0m")

def _core_update(runtime: str, args):
    print("\033[1m⬇ Pulling Global Core images...\033[0m")
    core.write_runtime_files(runtime)
    run(core.core_compose(runtime, "pull", "caddy", "router", "sockguard", "dashboard"), cwd=GLOBAL_CORE_DIR, capture_output=False)  # om_egress is built locally
    if not core.core_up(runtime):
        sys.exit(1)
    print("\033[32m✓ Global Core updated.\033[0m")

def _core_reload(runtime: str, args):
    if not prune_orphan_routes(runtime):
        reload_caddy(runtime=runtime)

def _core_watch(runtime: str, args):
    sys.exit(core.watch(runtime))

def _announce_image_updates(done: str) -> str:
    """Look for newer images at most every 6 hours (`om status` shows the result); notify, and extend `done`."""
    for wid, d in sorted(read_registry().items()):
        ws = Path(d.get("path", ""))
        if (ws / ".om" / "config.json").exists() and time.time() - cached_updates(wid)[1] > 6 * 3600:
            ups = available_updates(ws)
            n = len(ups)
            if n:
                done = (done + "; " if done else "") + f"{wid}: {n} image update(s) available"
                notify.notify(f"om: {wid}", f"{n} image update(s) available: {', '.join(sorted(ups))}. Run: om update --dry-run",
                              key=f"updates:{wid}:" + ",".join(f"{r}={d[1]}" for r, d in sorted(ups.items())))
    return done

def _core_heal(runtime: str, args):
    done = core.core_heal(runtime)
    # What heal had to fix (not the one-run wait before an address change): at most once an hour per message
    fixed = [n for n in done.split("; ") if n and "waiting one more run" not in n]
    if fixed:
        notify.notify("om core", "; ".join(fixed), key=f"heal:{'; '.join(fixed)}:{int(time.time() // 3600)}")
    done = _announce_image_updates(done)
    if done:
        core.LOG_DIR.mkdir(parents=True, exist_ok=True)
        with open(core.LOG_DIR / "heal.log", "a", encoding="utf-8") as log:
            log.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {done}\n")
        print(done)

def _core_status(runtime: str, args):
    print(f"\n\033[1mGLOBAL CORE\033[0m  (om {VERSION}, {runtime})")
    print("═" * 78)
    roles = {"om_caddy": "Edge proxy (front door)", "om_router": "Internal router",
             "om_egress": "Outbound allow-list proxy",
             "om_sockguard": "Read-only engine filter",
             "om_stream_edge": "Raw TCP edge", "om_stream_router": "Raw TCP router",
             "om_dashboard": "Universal dashboard"}
    for name, role in roles.items():
        st = "\033[32m🟢 Running\033[0m" if core.container_running(runtime, name) else "\033[31m⏹ Stopped\033[0m"
        print(f"  {name:<16} {role:<26} {st}")
    env = core.parse_env_file(core.RUNTIME_ENV)
    vpn = core.vpn_hosts()
    print(f"\n  Private tier: {core.base_url()}/" + "".join(f"  ·  VPN {core.base_url(h)}/" for h in vpn[-1:]))
    if env.get("LAN_IP") and not env["LAN_IP"].endswith(".invalid"):
        print(f"  Public tier:  {core.base_url(env['LAN_IP'])}/" + "".join(f"  ·  VPN http://{h}:8080/" for h in vpn[-1:]))
    for d in core.runtime_drift(runtime):
        print(f"  \033[33m⚠ {d}\033[0m")
    print()

def cmd_core(root: Path | None, args):
    actions = {"start": _core_start, "stop": _core_stop, "restart": _core_restart, "update": _core_update,
               "reload": _core_reload, "watch": _core_watch, "heal": _core_heal, "status": _core_status}
    actions[args.action](detect_runtime(), args)


# ── Workspace lifecycle ─────────────────────────────────────────────────────

def warn_exposed_ports(runtime: str, ws_id: str):
    """Warn about workspace containers publishing host ports (they bypass the edge proxy)."""
    r = run([runtime, "ps", "--format", "{{.Names}}\t{{.Ports}}"])
    for line in r.stdout.splitlines():
        name, _, ports = line.partition("\t")
        if name.startswith(f"{ws_id}_") and "->" in ports:
            print(f"  \033[31m⚠ {name} publishes host ports ({ports}).\033[0m")
            print("    These bypass the proxy and may be reachable from the LAN. Use 'expose:' instead of 'ports:'.")

def check_signature(root: Path, ws_id: str, kind: str) -> tuple[bool, str | None, bool]:
    """(may deploy, signer, dirty). A dirty tree runs as a dev generation (unsigned, marked dirty);
    a clean HEAD must be signed by a trusted key, or OM_SIGNED=enforce refuses it."""
    snap = generations.snapshot(root)
    if snap["commit"] is None:
        print("  \033[33m⚠ not a git repository: this deploy cannot be signed or rolled back (git init).\033[0m")
        return True, None, True
    if snap["dirty"]:
        print("  \033[33m⚠ uncommitted changes: running the working tree unsigned, generation marked dirty.\033[0m")
        return True, None, True
    trusted, who = generations.verify(ws_id, root)
    if trusted:
        print(f"  \033[32m✓ commit {snap['commit'][:8]} signed by {who}\033[0m")
        return True, who.split(" (")[0], False
    if generations.mode() == "enforce" and kind != "dev":
        print(f"  \033[31m✗ commit {snap['commit'][:8]}: {who}. Not deployed (OM_SIGNED=enforce).\033[0m")
        return False, None, False
    print(f"  \033[33m⚠ commit {snap['commit'][:8]}: {who} (OM_SIGNED=warn: deploying anyway).\033[0m")
    return True, None, False

def _isolate_projects(runtime: str, ws_id: str, root: Path, targets: list, configs: dict):
    """Each folder on its own internal network; the router and om_egress join them before anything starts.
    Returns (compose overrides, folders whose network failed, networks with an egress service, subnets)."""
    net_overrides, net_failed, needs_egress, project_subnets = {}, set(), set(), {}
    for _, d in targets:
        try:
            net, net_overrides[d] = project_network(runtime, ws_id, project_rel(root, d), d, configs[d][0])
            if net:
                project_subnets[d] = core.network_subnet(runtime, net)
        except RuntimeError as e:
            net_failed.add(d)
            print(f"    \033[31m✗ {d.name}: {e} — not started (it would share the workspace network)\033[0m")
            continue
        if policy.egress_services(configs[d][0]):
            needs_egress.add(net or f"{ws_id}_net")
    return net_overrides, net_failed, needs_egress, project_subnets

def _render_egress(runtime: str, ws_id: str, targets: list, configs: dict, project_subnets: dict, target: str | None):
    """Write the proxy rules of every service with om.egress; returns ({service: rule}, {service: proxy url})."""
    wanted, service_subnets = {}, {}
    for _, d in targets:
        cfg = configs[d][0]
        if cfg:
            eg_svcs = policy.egress_services(cfg)
            wanted.update(eg_svcs)
            for s in eg_svcs:
                service_subnets[s] = project_subnets.get(d)
    return wanted, egress.render_workspace(runtime, ws_id, wanted, prune=target is None, subnets=service_subnets)

def _attach_networks(runtime: str, ws_id: str, root: Path, targets: list, configs: dict, target: str | None, needs_egress: set):
    """om_egress only on networks with a service that may go out (elsewhere it is not even reachable); the
    router on all of them; networks of folders that are gone are removed on a full start."""
    known = core.egress_networks(ws_id)
    core.set_egress_networks(ws_id, sorted(needs_egress if target is None or known is None else set(known) | needs_egress))
    for net in core.connect_router(runtime, [ws_id]):
        print(f"    \033[33m⚠ could not attach the router/egress to {net}: its routes return 502\033[0m")
    if target is None:
        keep = {project_network_name(ws_id, project_rel(root, d)) for _, d in targets
                if not (configs[d][0] and shares_workspace_network(configs[d][0]))}
        for net in prune_project_networks(runtime, ws_id, keep):
            print(f"  \033[36m- Removed network {net} (its folder is gone)\033[0m")

def _announce_open_egress(wanted: dict):
    learning = sorted(s for s, h in wanted.items() if h == egress.LEARN)
    auditing = sorted(s for s, h in wanted.items() if h == egress.AUDIT)
    if learning:
        print(f"  \033[33m⚠ learning (any public host allowed, recorded): {', '.join(learning)} — `om egress log`, then list the hosts\033[0m")
    if auditing:
        print(f"  \033[36mℹ audit mode (all public egress logged permanently): {', '.join(auditing)} — see `om egress log`\033[0m")

def _policy_allows(ws_id: str, compose_file: Path, config: tuple) -> bool:
    """Run the deploy gate on one compose file and say what it found. False: refused (OM_POLICY=enforce)."""
    cfg = config[0]
    if cfg and shares_workspace_network(cfg) and f"{ws_id}_net" not in {(n or {}).get("name") for n in (cfg.get("networks") or {}).values()}:
        print(f"    \033[33m⚠ {compose_file.name} has om.network=shared but doesn't join {ws_id}_net: its routes return 502.\033[0m"
              "\n      Add: networks: {default: {name: ${WORKSPACE_NET}, external: true}}")
    violations, waived = policy.evaluate_compose(*config, ws_net=f"{ws_id}_net")
    if waived:
        print(f"    \033[36mℹ policy: {len(waived)} exception(s) allowed by {policy.ALLOW_LABEL} (see `om policy check`)\033[0m")
    if not violations:
        return True
    enforce = policy.mode() == "enforce"
    print(f"    \033[{'31m✗' if enforce else '33m⚠'} policy: {len(violations)} violation(s) in {compose_file.name}\033[0m")
    for v in violations:
        print(f"      - {v}")
    if enforce:
        print("      Not started (OM_POLICY=enforce). Fix the lines above; `om policy check` re-checks.")
        return False
    print("      Started anyway (OM_POLICY=warn); this will be refused once OM_POLICY=enforce.")
    return True

def _start_project(runtime: str, ws_id: str, env: dict, dir_path: Path, cfg: dict | None, build: bool, *,
                   proxy_urls: dict, pinned: dict, net_override, subnet) -> bool:
    """`compose up` for one folder with every override om adds (egress, lock, secrets, network, logging, limits)."""
    compose_file = find_compose_file(dir_path)
    up = ["up", "-d"] + (["--build"] if build and has_build(compose_file) else [])
    try:
        secret_override = agesecrets.write_override(runtime, ws_id, dir_path, cfg, core.STATE_DIR / "secrets" / "overrides")
    except RuntimeError as e:
        print(f"    \033[31m✗ secrets: {e} — not started (the host key is in {agesecrets.KEY_FILE})\033[0m")
        return False
    limits_override, limit_problems = limits.write_override(ws_id, dir_path, cfg)
    for problem in limit_problems:
        print(f"    \033[33m⚠ {problem} — ignored, no such limit\033[0m")
    overrides = [egress.write_override(ws_id, str(dir_path), cfg, proxy_urls, subnet=subnet),
                 lock.write_override(ws_id, str(dir_path), cfg, pinned), secret_override,
                 net_override, nolog_override(ws_id, dir_path, cfg), limits_override]
    extra = [a for o in overrides if o for a in ("-f", str(o))]
    res = run(compose(runtime, compose_file, *extra, *up), cwd=dir_path, env=env)
    if res.returncode != 0:
        print(f"    \033[31m❌ Failed to start {dir_path.name}:\033[0m\n{res.stderr.strip()[-1500:]}")
        return False
    print(f"    \033[32m✓ {dir_path.name} running\033[0m")
    return True

def start_workspace(root: Path, target: str | None = None, build: bool = False, kind: str = "start") -> bool:
    """Start services; build=True also rebuilds images of services that have a `build:` section.
    Every call is recorded as a generation (see lib/gitops/generations.py)."""
    ws_id = get_workspace_id(root)
    runtime = detect_runtime()
    allowed, signer, dirty = check_signature(root, ws_id, kind)
    if not allowed:
        generations.record(ws_id, root, kind, "refused", None)
        return False
    register_workspace(root, ws_id)
    hide_local_files(root)
    ensure_workspace_network(ws_id, runtime)
    ensure_core_running(runtime, ws_id)

    targets = discover_compose_dirs(root, target)
    if not targets:
        print("\n  \033[33mNo services or projects found.\033[0m Run '\033[1mom add <name>\033[0m' to scaffold one.\n")
        return True

    print(f"\n\033[1m🚀 Starting User Workloads [{ws_id.upper()}]\033[0m")
    print("─" * 78)
    env = get_workspace_env(root, ws_id, runtime)
    # Read every project once: routes, the policy gate and the egress proxy all work on `compose config`.
    configs = {d: policy.compose_config(runtime, find_compose_file(d), env) for _, d in targets}
    sync_caddy_routes(root, runtime, reload=False, configs={d: cfg for d, (cfg, _) in configs.items()})
    net_overrides, net_failed, needs_egress, project_subnets = _isolate_projects(runtime, ws_id, root, targets, configs)
    wanted, proxy_urls = _render_egress(runtime, ws_id, targets, configs, project_subnets, target)
    pinned = lock.read(root)
    unlocked = sorted({ref for cfg, _ in configs.values() for ref in lock.images(cfg).values()} - set(pinned))
    if unlocked:
        print(f"  \033[33m⚠ not in .om/lock.json (tag can change under you): {', '.join(unlocked)} — run `om lock`\033[0m")
    _attach_networks(runtime, ws_id, root, targets, configs, target, needs_egress)
    _announce_open_egress(wanted)

    ok = True
    for prio, dir_path in targets:
        print(f"  ▶ [Priority {prio:02d}] Starting \033[1m{dir_path.name}\033[0m...")
        config = configs[dir_path]
        # in this order, and each step only if the one before allowed it: gate, network, start
        if (not _policy_allows(ws_id, find_compose_file(dir_path), config)
                or dir_path in net_failed
                or not _start_project(runtime, ws_id, env, dir_path, config[0], build, proxy_urls=proxy_urls, pinned=pinned,
                                      net_override=net_overrides.get(dir_path), subnet=project_subnets.get(dir_path))):
            ok = False

    reload_caddy(runtime=runtime, workspace_id=ws_id)
    warn_exposed_ports(runtime, ws_id)
    for problem in links.sync(runtime):
        if problem.startswith(f"{ws_id}/") or f"={ws_id}/" in problem:
            print(f"    \033[33m⚠ link {problem}\033[0m")
    gen = generations.record(ws_id, root, ("dev" if dirty and kind == "start" else kind) + (f":{target}" if target else ""),
                             "running" if ok else "failed", signer)
    if ok and signer:
        generations.remember_signers(ws_id, root)
    print(f"\n\033[32m✓ User workloads live (generation {gen['n']}). Access via: {core.base_url(ws_id + '.<service>.localhost')}\033[0m\n")
    return ok

NOLOG_OVERRIDE_DIR = core.STATE_DIR / "nolog" / "overrides"

def nolog_override(ws: str, project_dir: Path, cfg: dict | None) -> Path | None:
    """Compose override discarding the own output (stdout/stderr) of services labelled om.log=off, or None:
    no trace in the engine's log either (a search engine logs failed upstream URLs, query included)."""
    quiet = sorted(name for name, svc in ((cfg or {}).get("services") or {}).items()
                   if str(policy._labels(svc or {}).get("om.log", "")).strip().lower() == "off")
    path = NOLOG_OVERRIDE_DIR / f"{ws}-{hashlib.sha256(str(project_dir).encode()).hexdigest()[:12]}.yml"
    if not quiet:
        path.unlink(missing_ok=True)
        return None
    lines = ["# Generated by om — om.log=off: the engine keeps none of these services' output. Do not edit.", "services:"]
    for name in quiet:
        lines += [f"  {json.dumps(name)}:", "    logging:", '      driver: "none"']
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n", encoding="utf-8", newline="\n")
    return path


def cmd_egress(root: Path | None, args):
    """Show what the egress proxy refused or learned, per service, and optionally apply suggestions."""
    runtime = detect_runtime()
    r = run([runtime, "logs", "--since", args.since, core.EGRESS])
    if r.returncode != 0:
        die(f"Cannot read {core.EGRESS} logs: {(r.stderr or r.stdout).strip()[-300:]}")
    log = r.stdout + "\n" + r.stderr
    denied, used = egress.denied_hosts(log), egress.used_hosts(log)
    only_ws = get_workspace_id(root) if root and not getattr(args, "all", False) else None

    targets = getattr(args, "target", []) or []
    target_svc = None
    if targets:
        words = [t for t in targets if t != "log"]
        if words:
            target_svc = words[0]

    apply_mode = getattr(args, "apply", False)

    shown = 0
    all_users = sorted(set(denied) | set(used))
    if target_svc:
        all_users = [u for u in all_users if u.endswith(f".{target_svc}")]

    for user in all_users:
        ws, _, svc = user.partition(".")
        if only_ws and ws != only_ws:
            continue
        current = egress._load_rules(ws).get(svc)
        rem = egress.learn_remaining(ws, svc)
        learn_data = egress.load_learn(ws, svc)
        hosts_info = learn_data.get("hosts", {})

        new_hosts = used.get(user, set()) | denied.get(user, set())
        sugg = egress.suggestion(None if current in (egress.LEARN, egress.AUDIT) else current, new_hosts)

        if current in (egress.LEARN, egress.AUDIT):
            shown += 1
            if current == egress.AUDIT:
                status_str = "(audit mode — permanent, no expiry)"
            elif rem == -1:
                status_str = "(learning — permanent, no expiry)"
            elif rem > 0:
                status_str = f"(learning, {rem // 3600}h {(rem % 3600) // 60}m left)"
            else:
                status_str = "(learning expired — fell back to deny-all)"
            print(f"\n  \033[1m{ws}/{svc}\033[0m \033[33m{status_str}\033[0m")
            if hosts_info:
                for h, inf in sorted(hosts_info.items()):
                    print(f"    - {h} ({inf.get('count', 1)} requests)")
            elif used.get(user):
                print(f"    used: {', '.join(sorted(used[user]))}")

            if apply_mode:
                _apply_suggestion_to_root(root, ws, svc, sugg)
            else:
                print(f"    when done, run: \033[36mom egress log {svc} --apply\033[0m")
                print(f"    or set in compose: \033[36mom.egress={sugg}\033[0m")

        elif denied.get(user):
            shown += 1
            print(f"\n  \033[1m{ws}/{svc}\033[0m was refused: {', '.join(sorted(denied[user]))}")
            if apply_mode:
                _apply_suggestion_to_root(root, ws, svc, sugg)
            else:
                print(f"    to allow, run: \033[36mom egress log {svc} --apply\033[0m")
                print(f"    or set in compose: \033[36mom.egress={sugg}\033[0m")

    if not shown:
        print(f"  Nothing refused or learned in the last {args.since}"
              + (f" for workspace {only_ws}" if only_ws else "") + ".\n"
              "  A service without om.egress never reaches the proxy; set `om.egress=learn` (discovery) or `om.egress=audit` (permanent) to record and allow what it uses.")
    print()

def _apply_suggestion_to_root(root: Path | None, ws: str, svc: str, sugg: str):
    target_root = None
    if root:
        try:
            if get_workspace_id(root) == ws:
                target_root = root
        except Exception:
            pass
    if not target_root:
        reg = read_registry()
        if ws in reg and Path(reg[ws].get("path", "")).is_dir():
            target_root = Path(reg[ws]["path"])
        elif root:
            target_root = root

    if not target_root:
        print(f"    \033[31m✗ Could not find workspace directory for '{ws}'\033[0m")
        return

    applied = False
    for _, d in discover_compose_dirs(target_root):
        cfile = find_compose_file(d)
        if cfile and egress.apply_egress_label(cfile, svc, sugg.split(",")):
            applied = True
            try:
                rel = cfile.relative_to(target_root)
            except ValueError:
                rel = cfile
            print(f"    \033[32m✓ Updated {rel}:\033[0m om.egress={sugg}")
            print("      Run 'git diff' to review and 'om start' to apply.")
            break
    if not applied:
        print(f"    \033[31m✗ Could not find compose file defining service '{svc}' in {target_root}\033[0m")

def cmd_policy(root: Path | None, args):
    """Report policy-gate violations for this workspace (or every registered one with --all)."""
    runtime = detect_runtime()
    if args.all:
        roots = [(wid, Path(d["path"])) for wid, d in sorted(read_registry().items()) if Path(d.get("path", "")).exists()]
    elif root:
        roots = [(get_workspace_id(root), root)]
    else:
        die("fatal: not an om workspace. Use `om policy check --all` to check every registered workspace.")
    total = 0
    for ws_id, ws_root in roots:
        env = get_workspace_env(ws_root, ws_id, runtime)
        for _, dir_path in discover_compose_dirs(ws_root):
            cf = find_compose_file(dir_path)
            found, waived = policy.check_compose_file(runtime, cf, env)
            total += len(found)
            mark = "\033[32m✓\033[0m" if not found else "\033[31m✗\033[0m"
            print(f"  {mark} {ws_id}: {cf.relative_to(ws_root)}")
            for v in found:
                print(f"      - {v}")
            for w in waived:
                print(f"      \033[36m~ allowed by {policy.ALLOW_LABEL}: {w}\033[0m")
    print(f"\n  {total} violation(s); mode: {policy.mode()} (OM_POLICY in {core.USER_ENV})")
    sys.exit(1 if total else 0)

def cmd_start(root: Path, args):
    if not start_workspace(root, getattr(args, "target", None), build=getattr(args, "build", False)):
        sys.exit(1)

def cmd_dev(root: Path, args):
    runtime = detect_runtime()
    proj_dir = resolve_target(root, args.project)
    print(f"\033[1m🛠️  Launching dev container for {args.project}...\033[0m")
    start_workspace(root, args.project, build=True, kind="dev")
    names = service_containers(runtime, root, proj_dir)
    print(f"\n\033[36mStreaming live logs for {names[0]} (Ctrl+C to detach; the container keeps running)...\033[0m")
    try:
        subprocess.run([runtime, "logs", "-f", "--tail", "50", names[0]])
    except KeyboardInterrupt:
        print("\nDetached from logs.")

def cmd_stop(root: Path, args):
    ws_id = get_workspace_id(root)
    runtime = detect_runtime()
    env = get_workspace_env(root, ws_id, runtime)
    stop_all = getattr(args, "all", False)
    targets = list(reversed(discover_compose_dirs(root, getattr(args, "target", None))))
    if not targets and not stop_all:
        print("\033[33mNo matching services or projects found to stop.\033[0m")
        return

    print(f"\n\033[1m🛑 Stopping User Workloads [{ws_id.upper()}]...\033[0m")
    for _prio, dir_path in targets:
        print(f"  ■ Stopping {dir_path.name}...")
        run(compose(runtime, find_compose_file(dir_path), "down"), cwd=dir_path, env=env)

    if not getattr(args, "target", None):
        agesecrets.wipe(ws_id)  # decrypted copies live only while the workspace runs
        try:
            egress.render_workspace(runtime, ws_id, {}, prune=True)
        except Exception:
            pass
    if stop_all:
        core.core_down(runtime)
        print("\033[32m✓ Workspace and Global Core stopped.\033[0m\n")
    else:
        print(f"\033[32m✓ User workloads stopped. Dashboard remains live at {core.base_url()}/\033[0m\n")

def cmd_down(root: Path, args):
    args.all = True
    args.target = None
    cmd_stop(root, args)

def workspace_images(root: Path, target: str | None, report: bool = False) -> tuple[dict, set, set]:
    """({image ref: [services using it]}, held refs, auto refs). A ref is held when any service using it
    has om.update=hold, and auto only when every service using it has om.update=auto."""
    runtime = detect_runtime()
    env = get_workspace_env(root, get_workspace_id(root), runtime)
    users, held, seen = {}, set(), {}
    for _, d in discover_compose_dirs(root, target):
        cfg, err = policy.compose_config(runtime, find_compose_file(d), env)
        if err and report:
            print(f"  \033[31m✗ {err}\033[0m")
        modes, bad = lock.update_modes(cfg)
        for line in bad if report else []:
            print(f"  \033[33m⚠ {line} is not one of {', '.join(lock.MODES)}; treated as manual\033[0m")
        for svc, ref in lock.images(cfg).items():
            users.setdefault(ref, []).append(svc)
            seen.setdefault(ref, set()).add(modes.get(svc))
            if modes.get(svc) == "hold":
                held.add(ref)
    return users, held, {ref for ref, m in seen.items() if m == {"auto"}}

def lock_workspace(root: Path, target: str | None, refresh: bool, only: set | None = None) -> tuple[dict, dict]:
    """Resolve digests for this workspace's pulled images into .om/lock.json. Returns (old, new).
    With refresh, `only` limits which refs move (default all) and held refs never do."""
    runtime = detect_runtime()
    users, held, _ = workspace_images(root, target, report=True)
    refs = set(users)
    old = lock.read(root)
    move = (refs if only is None else refs & only) - held if refresh else refs
    new, missing = lock.resolve(runtime, refs - move, old, refresh=False)
    moved, missing_moved = lock.resolve(runtime, move, old, refresh=refresh)
    new, missing = {**new, **moved}, missing + missing_moved
    for ref in sorted(held & refs) if refresh else []:
        print(f"  ⏸ {ref} is held (om.update=hold), pin unchanged")
    if target:  # keep the other projects' pins
        new = {**old, **new}
    for ref in missing:
        print(f"  \033[33m⚠ no digest for {ref} (registry needs a login? pull it once, then `om lock`)\033[0m")
    lock.write(root, new)
    for ref in sorted(set(old) | set(new)):
        if old.get(ref) != new.get(ref):
            print(f"  {ref}  {old[ref][7:19] if ref in old else 'unpinned'} → {new[ref][7:19] if ref in new else 'removed'}")
    return old, new

def commit_lock(root: Path, message: str):
    """Commit only .om/lock.json (signed if git is configured to sign)."""
    if run_git(["rev-parse", "--is-inside-work-tree"], root)[0] != 0:
        return
    if run_git(["diff", "--quiet", "--", lock.LOCK_NAME], root)[0] == 0 and \
            run_git(["ls-files", "--error-unmatch", lock.LOCK_NAME], root)[0] == 0:
        return
    run_git(["add", lock.LOCK_NAME], root)
    code, _, err = run_git(["commit", "-m", message, "--", lock.LOCK_NAME], root)
    print("  \033[32m✓ committed .om/lock.json\033[0m" if code == 0 else f"  \033[33m⚠ could not commit the lock: {err.strip()[-300:]}\033[0m")

def cmd_lock(root: Path, args):
    """Pin images that are not in .om/lock.json yet (existing pins stay)."""
    old, new = lock_workspace(root, None, refresh=False)
    print(f"\033[32m✓ {len(new)} image(s) pinned in {lock.LOCK_NAME}.\033[0m" + ("" if new != old else " (no change)"))
    if new != old:
        print("  Commit it to make it part of what runs: git commit .om/lock.json")

UPDATES_DIR = core.STATE_DIR / "registry" / "updates"  # under registry/: the dashboard mounts that read-only

def available_updates(root: Path, target: str | None = None) -> dict:
    """{ref: (pinned, newest)} for images whose tag now points at another digest. Writes the cache."""
    ws_id = get_workspace_id(root)
    pinned = lock.read(root)
    users, held, _ = workspace_images(root, target)
    out = {}
    for ref in sorted(set(users) - held):
        newest = lock.registry_digest(ref)
        if newest and pinned.get(ref) and newest != pinned[ref]:
            out[ref] = (pinned[ref], newest)
    if not target:
        UPDATES_DIR.mkdir(parents=True, exist_ok=True)
        (UPDATES_DIR / f"{ws_id}.json").write_text(json.dumps({"checked": int(time.time()), "updates": sorted(out),
                                                               "services": sorted(s for ref in out for s in users.get(ref, []))}) + "\n",
                                                   encoding="utf-8", newline="\n")
    return out

def cached_updates(ws_id: str) -> tuple[list, int]:
    try:
        d = json.loads((UPDATES_DIR / f"{ws_id}.json").read_text(encoding="utf-8"))
        return d.get("updates", []), d.get("checked", 0)
    except (OSError, ValueError):
        return [], 0

def _describe_change(ref: str, old: str, new: str) -> str:
    """'  (built 2026-09-02 → 2026-10-20, 52.1 → 52.3 MB)' from the registry, or '' if it will not say."""
    a, b = lock.describe(ref, old), lock.describe(ref, new)
    bits = []
    if a.get("created") or b.get("created"):
        bits.append(f"built {a.get('created') or '?'} → {b.get('created') or '?'}")
    if a.get("size") and b.get("size"):
        bits.append(f"{a['size'] / 1048576:.1f} → {b['size'] / 1048576:.1f} MB")
    return f"  ({', '.join(bits)})" if bits else ""

def cmd_update(root: Path, args):
    """Re-resolve every tag to its current digest, commit the lock, rebuild, recreate, health-check."""
    ws_id = get_workspace_id(root)
    runtime = detect_runtime()
    users, _, _ = workspace_images(root, args.target)
    if args.dry_run:
        ups = available_updates(root, args.target)
        for ref, (old, new) in ups.items():
            print(f"  {ref}  {old[7:19]} → {new[7:19]}  [{', '.join(users.get(ref, []))}]{_describe_change(ref, old, new)}")
        print(f"  {len(ups)} update(s) available." + ("  Apply: om update" + (f" {args.target}" if args.target else "") + " (--image REF to pick, -i to choose)" if ups else ""))
        return
    env = get_workspace_env(root, ws_id, runtime)
    targets = discover_compose_dirs(root, args.target)
    if not targets:
        die("Nothing to update.")
    only = set(args.image) if args.image else None
    for ref in only or ():
        if ref not in users:
            die(f"{ref} is not an image of this workspace (`om update --dry-run` lists them).")
    if args.choose:
        if not sys.stdin.isatty():
            die("--choose needs a terminal.")
        ups = available_updates(root, args.target)
        only = {ref for ref, (old, new) in ups.items() if (only is None or ref in only)
                and input(f"  Update {ref} [{', '.join(users.get(ref, []))}] {old[7:19]} → {new[7:19]}? [y/N] ").strip().lower() in ("y", "yes")}
        if not only:
            print("  Nothing selected.")
            return
    print("  ⬇ Checking registries for newer digests...")
    old, new = lock_workspace(root, args.target, refresh=True, only=only)
    if new != old:
        commit_lock(root, "om update: " + ", ".join(sorted(r for r in new if old.get(r) != new.get(r))))
    available_updates(root)  # the pins just moved: refresh what `om status` lists (whole workspace)
    for _prio, dir_path in targets:
        cf = find_compose_file(dir_path)
        if has_build(cf):
            print(f"  🔨 Rebuilding {dir_path.name}...")
            r = run(compose(runtime, cf, "build", "--pull"), cwd=dir_path, env=env)
            if r.returncode != 0:
                print(f"    \033[31m❌ build failed: {(r.stderr or r.stdout).strip()[-500:]}\033[0m")
    # Same path as `om start`: policy gate, egress and lock overrides, routes.
    if not start_workspace(root, args.target, kind="update"):
        sys.exit(1)
    print("  Health check...")
    if run_synthetic_health_check(workspace_vhosts(ws_id)):
        print("\033[32m✓ All services healthy.\033[0m")
    else:
        sys.exit(1)

def _service_dir(root: Path, name: str) -> Path:
    """A service folder by name, including ones disabled with .omignore (which discovery skips)."""
    for base in (root, *sorted(p for p in root.iterdir() if p.is_dir() and not p.name.startswith("."))):
        d = base / name
        if d.is_dir() and find_compose_file(d):
            return d
    die(f"No service or project named '{name}' in this workspace. See `om status`.")

def cmd_disable(root: Path, args):
    """Stop a service and mark it .omignore so start/restart and its routes skip it until `om enable`."""
    runtime = detect_runtime()
    dir_path = _service_dir(root, args.service)
    if dir_path == root:
        die("Refusing to disable the workspace root compose project.")
    if (dir_path / ".omignore").exists():
        die(f"{dir_path.name} is already disabled.")
    env = get_workspace_env(root, get_workspace_id(root), runtime)
    run(compose(runtime, find_compose_file(dir_path), "down"), cwd=dir_path, env=env)
    (dir_path / ".omignore").write_text("disabled by `om disable`; remove with `om enable`\n", encoding="utf-8")
    sync_caddy_routes(root, runtime)
    try:
        ws_id = get_workspace_id(root)
        active_egress = {}
        for _, d in discover_compose_dirs(root, None):
            cf = find_compose_file(d)
            if cf:
                cfg_res = policy.compose_config(runtime, cf, env)
                if cfg_res and cfg_res[0]:
                    active_egress.update(policy.egress_services(cfg_res[0]))
        egress.render_workspace(runtime, ws_id, active_egress, prune=True)
    except Exception:
        pass
    print(f"\033[32m✓ Disabled {dir_path.name}.\033[0m Re-enable with `om enable {dir_path.name}`")

def cmd_enable(root: Path, args):
    dir_path = _service_dir(root, args.service)
    marker = dir_path / ".omignore"
    if not marker.exists():
        die(f"{dir_path.name} is not disabled.")
    marker.unlink()
    print(f"\033[32m✓ Enabled {dir_path.name}.\033[0m Start it with `om start {dir_path.name}`")

def cmd_remove(root: Path, args):
    """Stop a service, move it (and optionally its data) to .om/trash, and drop its routes."""
    ws_id = get_workspace_id(root)
    runtime = detect_runtime()
    dir_path = resolve_target(root, args.service)
    if dir_path == root:
        die("Refusing to remove the workspace root compose project.")
    data_dir = root / "data" / dir_path.name
    what = f"{dir_path.relative_to(root)}" + (f" and {data_dir.relative_to(root)}" if args.data and data_dir.exists() else "")
    if not args.yes and not confirm(f"Remove {what}? (moved to .om/trash, recoverable)"):
        die("Aborted.")

    env = get_workspace_env(root, ws_id, runtime)
    run(compose(runtime, find_compose_file(dir_path), "down"), cwd=dir_path, env=env)
    hide_local_files(root)
    trash = root / ".om" / "trash" / time.strftime("%Y%m%d-%H%M%S")
    trash.mkdir(parents=True, exist_ok=True)
    shutil.move(str(dir_path), str(trash / dir_path.name))
    if args.data and data_dir.exists():
        shutil.move(str(data_dir), str(trash / f"data-{dir_path.name}"))
    sync_caddy_routes(root, runtime)
    print(f"\033[32m✓ Removed {dir_path.name}.\033[0m Restore from {trash}")

def cmd_logs(root: Path, args):
    runtime = detect_runtime()
    names = service_containers(runtime, root, resolve_target(root, args.service))
    cmd = [runtime, "logs", "--tail", str(args.tail)] + (["-f"] if args.follow else [])
    try:
        if args.follow or len(names) == 1:
            subprocess.run(cmd + [names[0]])
        else:
            for n in names:
                print(f"\033[1m── {n} ──\033[0m")
                subprocess.run(cmd + [n])
    except KeyboardInterrupt:
        pass

def cmd_shell(root: Path, args):
    runtime = detect_runtime()
    name = service_containers(runtime, root, resolve_target(root, args.service))[0]
    inner = args.cmd or ["sh", "-c", "command -v bash >/dev/null 2>&1 && exec bash || exec sh"]
    tty = ["-it"] if sys.stdin.isatty() else ["-i"]
    sys.exit(subprocess.run([runtime, "exec", *tty, name, *inner]).returncode)


# ── Status & inspection ─────────────────────────────────────────────────────

def cmd_status(root: Path | None, args):
    runtime = detect_runtime()
    states = {}
    r = run([runtime, "ps", "-a", "--format", "{{.Names}}\t{{.Status}}\t{{.State}}"])
    for line in r.stdout.strip().splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            states[parts[0]] = parts

    def badge(name):
        p = states.get(name)
        if not p:
            return "\033[90m⚪ Offline\033[0m"
        status, state = p[1].lower(), p[2].lower()
        if "up" in status or state == "running":
            return "\033[32m🟢 Running\033[0m"
        if "exited" in status and "exited (0)" not in status:
            return "\033[31m❌ Crashed\033[0m"
        return "\033[33m⏹ Stopped\033[0m"

    if getattr(args, "json", False):
        def state(name):
            p = states.get(name)
            if not p:
                return "absent"
            st, sta = p[1].lower(), p[2].lower()
            return "running" if ("up" in st or sta == "running") else ("crashed" if "exited" in st and "exited (0)" not in st else "stopped")
        out = {"version": VERSION, "runtime": runtime, "core": {c: state(c) for c in core.CORE_CONTAINERS}}
        if root:
            ws_id = get_workspace_id(root)
            gen = generations.current(ws_id)
            ups, checked = cached_updates(ws_id)
            st_ports = core.stream_ports()
            out["workspace"] = {
                "id": ws_id, "path": str(root), "generation": gen, "updates": ups, "updates_checked": checked,
                "services": [{"service": d.name, "containers": {n: state(n) for n in service_containers(runtime, root, d)},
                              "scope": st_ports.get(f"{ws_id}/{d.name}", {}).get("scope") or ("public" if (CONF_D / f"{ws_id}-{d.name}.public_alias").exists() else "private")}
                             for _, d in discover_compose_dirs(root, None)]}
        emit_json(out)
        return

    print(f"\n\033[1mOM PLATFORM\033[0m  (om {VERSION})")
    print("═" * 78)
    for name, role in (("om_caddy", "edge proxy"), ("om_router", "internal router"), ("om_egress", "outbound allow-list proxy"),
                       ("om_sockguard", "read-only engine filter"),
                       ("om_stream_edge", "raw TCP edge"), ("om_stream_router", "raw TCP router"),
                       ("om_dashboard", "dashboard  http://localhost/")):
        print(f"  {name:<16} {badge(name):<22} {role}")

    if not root:
        cmd_list(args)
        return

    ws_id = get_workspace_id(root)
    print(f"\n\033[1mWORKSPACE: {ws_id}\033[0m  ({root})")
    print("─" * 78)
    print(f"  {generation_summary(ws_id, root)}")
    ups, checked = cached_updates(ws_id)
    if ups:
        print(f"  \033[36mupdates  {len(ups)} available ({', '.join(u.rsplit('/', 1)[-1] for u in ups)}) — om update --dry-run\033[0m")
    targets = discover_compose_dirs(root, None)
    if not targets:
        print("  (no services yet — `om add <name>`)")
    st_ports = core.stream_ports()
    env = core.parse_env_file(core.RUNTIME_ENV)
    lan = env.get("LAN_IP", "")
    lan = "" if lan.endswith(".invalid") else lan
    for _prio, d in targets:
        names = service_containers(runtime, root, d)
        kind = "project" if d.parent.name == "projects" else "service"
        url = "—"
        st = st_ports.get(f"{ws_id}/{d.name}")
        if (CONF_D / f"{ws_id}-{d.name}.caddy").exists():
            url = core.base_url(f"{ws_id}.{d.name}.localhost")
        elif st:
            hp = st.get("host_port")
            url = f"tcp://{lan}:{hp}" if st.get("scope") == "public" and lan else f"tcp://localhost:{hp}"
        tier = st.get("scope") if st else ("public" if (CONF_D / f"{ws_id}-{d.name}.public_alias").exists() else "private")
        print(f"  {d.name:<20} {kind:<8} {badge(names[0]):<22} {tier:<8} {url}")
    print()

def generation_summary(ws_id: str, root: Path) -> str:
    gen, now = generations.current(ws_id), generations.snapshot(root)
    if not gen:
        return "generation —  (nothing deployed through om yet: om start)"
    state = "\033[33mdirty\033[0m" if gen.get("dirty") else "\033[32mclean\033[0m"
    who = f"signed by {gen['signer']}" if gen.get("signer") else "\033[33munsigned\033[0m"
    line = f"generation {gen['n']}  {state}  {(gen.get('commit') or '—')[:8]}  {who}  ({gen['kind']}, {gen['time']})"
    if now["commit"] != gen.get("commit") or now["dirty"] != gen.get("dirty") or now["lock"] != gen.get("lock"):
        line += "\n  \033[33m⚠ the workspace changed since this generation (commit, lock or files): om start\033[0m"
    return line


def cmd_log(root: Path, args):
    """Generations of this workspace, newest first."""
    ws_id = get_workspace_id(root)
    es = generations.entries(ws_id)
    if getattr(args, "json", False):
        emit_json({"workspace": ws_id, "generations": list(reversed(es[-args.n:] if args.n else es)),
                   "problems": generations.verify_chain(ws_id)})
        return
    if not es:
        print("  No generations yet: om start")
        return
    print(f"\n\033[1mGENERATIONS: {ws_id}\033[0m")
    print("─" * 78)
    for e in reversed(es[-args.n:] if args.n else es):
        res = {"running": "\033[32mrunning\033[0m", "failed": "\033[31mfailed\033[0m",
               "refused": "\033[31mrefused\033[0m"}.get(e.get("result"), e.get("result"))
        flags = " dirty" if e.get("dirty") else ""
        signer = e.get("signer") or "unsigned"
        print(f"  {e.get('n'):>4}  {(e.get('commit') or '—')[:8]}  {res:<18} {e.get('kind', ''):<14} {e.get('time', '')}  {signer}{flags}")
    for p in generations.verify_chain(ws_id):
        print(f"  \033[31m✗ {p}\033[0m")
    print()

def cmd_rollback(root: Path, args):
    """Check out the commit of an earlier generation (detached, like `git checkout`) and deploy it."""
    ws_id = get_workspace_id(root)
    es = [e for e in generations.entries(ws_id) if e.get("result") == "running" and e.get("commit") and not e.get("dirty")]
    cur = generations.current(ws_id)
    if args.generation:
        target = next((e for e in es if e["n"] == args.generation), None)
        if not target:
            die(f"Generation {args.generation} is not a clean, successfully started generation (see `om log`).")
    else:
        target = next((e for e in reversed(es) if not cur or e["commit"] != cur.get("commit")), None)
        if not target:
            die("No earlier clean generation with a different commit to roll back to (see `om log`).")
    if generations.snapshot(root)["dirty"]:
        die("Uncommitted changes: commit or stash them first (rollback checks out another commit).")
    print(f"\033[33m⏪ Rolling back to generation {target['n']} ({target['commit'][:8]})\033[0m — volumes and data are not rolled back.")
    code, _, err = run_git(["checkout", "--detach", target["commit"]], root)
    if code != 0:
        die(f"git checkout failed: {err}")
    ok = start_workspace(root, kind="rollback")
    print(f"  HEAD is detached at {target['commit'][:8]}. To continue on your branch: git checkout {tracked_branch(root)}")
    sys.exit(0 if ok else 1)

def running_digests(runtime: str, ws_id: str) -> dict:
    """{service: set of RepoDigests} for this workspace's running containers."""
    r = run([runtime, "ps", "--filter", f"label=com.docker.compose.project={ws_id}",
             "--format", '{{.Image}}\t{{index .Labels "com.docker.compose.service"}}'])
    out = {}
    for line in r.stdout.splitlines():
        img, _, svc = line.partition("\t")
        info = run([runtime, "image", "inspect", "--format", "{{json .RepoDigests}}", img])
        try:
            out[svc] = {d.rsplit("@", 1)[-1] for d in json.loads(info.stdout or "[]")}
        except ValueError:
            out[svc] = set()
    return out

def cmd_fsck(root: Path, args):
    """Verify the generation chain, the deployed commit's signature, and running images against the lock."""
    ws_id = get_workspace_id(root)
    runtime = detect_runtime()
    env = get_workspace_env(root, ws_id, runtime)
    problems = list(generations.verify_chain(ws_id))
    cur = generations.current(ws_id)
    if cur and cur.get("commit") and not cur.get("dirty"):
        trusted, who = generations.verify(ws_id, root, cur["commit"])
        if not trusted:
            problems.append(f"generation {cur['n']} commit {cur['commit'][:8]}: {who}")
    pinned = lock.read(root)
    running = running_digests(runtime, ws_id)
    for _, d in discover_compose_dirs(root):
        cfg, _ = policy.compose_config(runtime, find_compose_file(d), env)
        for svc, ref in lock.images(cfg).items():
            if ref not in pinned:
                problems.append(f"{svc}: {ref} is not in .om/lock.json (om lock)")
            elif svc in running and pinned[ref] not in running[svc]:
                problems.append(f"{svc}: running image is not the locked {pinned[ref][:19]}… (om start)")
    for p in problems:
        print(f"  \033[31m✗ {p}\033[0m")
    print("\033[32m✓ generations chain, signature and running images match the lock.\033[0m" if not problems
          else f"\n  {len(problems)} problem(s).")
    sys.exit(1 if problems else 0)

def cmd_list(args):
    reg = read_registry()
    if getattr(args, "json", False):
        emit_json([{"id": w, "path": d.get("path"), "exists": (Path(d.get("path", "")) / ".om" / "config.json").is_file(),
                    "last_active": d.get("last_active")} for w, d in sorted(reg.items())])
        return
    print("\n\033[1mREGISTERED WORKSPACES\033[0m")
    print("═" * 78)
    if not reg:
        print("  None yet. Run 'om init' in a directory to create one.\n")
        return
    missing = []
    for ws_id, data in sorted(reg.items()):
        path = data.get("path", "")
        exists = Path(path).exists()
        if not exists:
            missing.append(ws_id)
        st = "\033[32mACTIVE\033[0m " if exists else "\033[31mMISSING\033[0m"
        print(f"  {ws_id:<20} {st}  {path}")
    if missing and getattr(args, "prune", False):
        update_registry(lambda reg: [reg.pop(w, None) for w in missing])
        removed = prune_orphan_routes(detect_runtime(), quiet=True, force=True)
        print(f"\n  \033[36mPruned: {', '.join(missing)} ({len(removed)} route file(s) removed)\033[0m")
    elif missing:
        print("\n  Missing folders (e.g. unplugged drive) are kept; `om list --prune` removes them.")
    print()


def harden_network(root: Path, ws_id: str, runtime: str) -> bool:
    """Recreate <ws>_net as internal: stop the workspace, swap the network, start it again."""
    net = f"{ws_id}_net"
    if core.network_is_internal(runtime, net):
        print(f"\033[32m✓ {net} is already internal.\033[0m")
        return True
    print(f"\033[1m🔒 Hardening {net}\033[0m: services will reach only the hosts in their om.egress label.")
    cmd_stop(root, argparse.Namespace(target=None, all=False))
    for c in (core.ROUTER, core.EGRESS):
        run([runtime, "network", "disconnect", "-f", net, c])
    r = run([runtime, "network", "rm", net])
    if r.returncode != 0:
        print(f"\033[31m✗ Could not remove {net}:\033[0m {(r.stderr or r.stdout).strip()[-400:]}\n"
              f"  Something outside this workspace still uses it (`{runtime} network inspect {net}`). Restarting as it was.")
        core.connect_router(runtime, [ws_id])
        start_workspace(root)
        return False
    ok = core.ensure_network(runtime, net, internal=True) and core.network_is_internal(runtime, net)
    core.connect_router(runtime, [ws_id])
    ok = start_workspace(root) and ok
    print(f"\033[32m✓ {net} is internal.\033[0m Blocked calls: `om egress log`." if ok
          else f"\033[31m✗ Hardening {net} did not complete — see above.\033[0m")
    return ok

def cmd_network(root: Path, args):
    ws_id = get_workspace_id(root)
    runtime = detect_runtime()
    if getattr(args, "action", "show") == "harden":
        sys.exit(0 if harden_network(root, ws_id, runtime) else 1)
    print("\n  internet/LAN ─► om_caddy (edge, om_core_net only) ─[token]─► om_router ─► services")
    print("  Each folder has its own network: services in different folders cannot reach each other (om.link joins two).")
    for net in [f"{ws_id}_net"] + core.project_networks(runtime, ws_id):
        r = run([runtime, "ps", "-a", "--filter", f"network={net}", "--format", "{{.Names}}"])
        members = sorted(r.stdout.split())
        services = [m for m in members if m not in (core.ROUTER, core.EGRESS)]
        if net == f"{ws_id}_net" and not services and core.project_networks(runtime, ws_id):
            continue  # every folder has its own network; the shared one is empty
        print(f"\n\033[1mNETWORK {net}\033[0m" + ("  (shared: om.network=shared)" if net == f"{ws_id}_net" else ""))
        print("═" * 78)
        for m in members:
            role = {"om_router": "router (accepts only edge-signed requests)",
                    "om_egress": "egress proxy (only listed hosts, per service)"}.get(m, "service")
            print(f"  • {m:<28} {role}")
        if "om_router" not in members:
            print("  \033[31m⚠ om_router is not attached — run `om start` or `om core start`.\033[0m")
        if core.network_is_internal(runtime, net):
            print("  \033[32m✓ internal: no way out except om_egress, for services with om.egress\033[0m")
        else:
            print("  \033[33m⚠ open: containers can reach the internet and the LAN — `om network harden`\033[0m")
        if "om_caddy" in members:
            print("  \033[31m⚠ om_caddy (edge) is attached to this network — containers can reach the private tier. Run `om core restart`.\033[0m")
    print()


# ── Scripts ─────────────────────────────────────────────────────────────────

def cmd_scripts(root: Path, args):
    scripts_dir = root / "scripts"
    groups: dict[str, list] = {}
    for f in (scripts_dir.rglob("*") if scripts_dir.exists() else []):
        if not f.is_file() or f.name.startswith(".") or not (f.suffix in SCRIPT_EXTS or os.access(f, os.X_OK)):
            continue
        try:
            with open(f, "rb") as fh:
                head = fh.read(4096)
        except OSError:
            continue
        if f.suffix not in SCRIPT_EXTS and not head.startswith(EXEC_MAGIC):
            continue                                # executable bit, but not runnable (e.g. a .cpp)
        rel = f.relative_to(scripts_dir)
        desc = None if b"\0" in head else script_description(head, f.name)
        groups.setdefault(rel.parent.as_posix(), []).append((rel.with_suffix("").name, desc))
    if not groups:
        print(f"\033[33mNo scripts found in {scripts_dir}\033[0m")
        return
    count = sum(len(g) for g in groups.values())
    name_w = max(len(name) for g in groups.values() for name, _ in g)
    desc_col = name_w + 6
    desc_w = max(shutil.get_terminal_size((80, 24)).columns - desc_col - 1, 20)
    print(f"\n\033[1mSCRIPTS [{get_workspace_id(root)}]\033[0m  \033[2m{count} in scripts/\033[0m")
    print("═" * 78)
    for folder in sorted(groups, key=lambda g: (g != ".", g.lower())):
        indent = "  "
        if folder != ".":
            print(f"  \033[36m{folder}/\033[0m")
            indent = "    "
        for name, desc in sorted(groups[folder], key=lambda r: r[0].lower()):
            if desc is None:
                desc = "\033[2mbinary\033[0m"
            elif len(desc) > desc_w:
                desc = desc[:desc_w - 1].rstrip() + "…"
            print(f"{indent}\033[1m{name}\033[0m{' ' * (desc_col - len(indent) - len(name))}{desc}")
        if folder == "." and len(groups) > 1:
            print()
    print("\n  \033[2mRun one: om run <folder>/<name> [args…]\033[0m\n")

def cmd_run(root: Path, args):
    scripts_dir = (root / "scripts").resolve()
    target = args.script
    candidates = [scripts_dir / f"{target}{ext}" for ext in ("", ".py", ".sh", ".bash", ".ps1")]
    script_path = next((c for c in candidates if c.is_file()), None)
    if not script_path:
        script_path = next((f for f in scripts_dir.rglob("*") if f.is_file()
                            and f.name in [target] + [f"{target}{e}" for e in SCRIPT_EXTS]), None)
    if not script_path:
        die(f"Script '{target}' not found in {scripts_dir}. Run `om scripts`.")
    if not script_path.resolve().is_relative_to(scripts_dir):
        die("Security violation: script path escapes the scripts directory.")

    env = get_workspace_env(root, get_workspace_id(root), detect_runtime())
    ext = script_path.suffix.lower()
    if ext == ".py":
        cmd = [sys.executable, str(script_path)]
    elif ext == ".ps1":
        cmd = ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(script_path)]
    elif os.name != "nt" and os.access(script_path, os.X_OK):
        cmd = [str(script_path)]
    else:
        bash = shutil.which("bash")
        if not bash:
            die("This script needs bash (on Windows: Git Bash or WSL).")
        cmd = [bash, str(script_path)]
    print(f"\033[36m▶ Running {script_path.relative_to(root)}\033[0m\n")
    try:
        sys.exit(subprocess.run(cmd + args.args, cwd=root, env=env).returncode)
    except KeyboardInterrupt:
        sys.exit(130)


# ── Route generation ────────────────────────────────────────────────────────


# ── Scaffolding & editing ───────────────────────────────────────────────────

def cmd_add(root: Path, args):
    """Scaffold a new service or developer project with routing."""
    ws_id = get_workspace_id(root)
    runtime = detect_runtime()
    try:
        p = scaffold.plan(args, ws_id, root)
    except ValueError as e:
        die(str(e))
    dest, name, port = p["dest"], p["name"], p["port"]
    dest.mkdir(parents=True)
    for fname, content in scaffold.project_files(p).items():
        (dest / fname).write_text(content, encoding="utf-8", newline="\n")
    (dest / "compose.yml").write_text(scaffold.render_compose(p), encoding="utf-8", newline="\n")
    ensure_workspace_network(ws_id, runtime)
    sync_caddy_routes(root, runtime)

    badge = "\033[36m[PUBLIC / LAN]\033[0m" if args.public else "\033[33m[PRIVATE]\033[0m"
    print(f"\033[32m✓ Scaffolded {'project' if p['is_project'] else 'service'} at {dest.relative_to(root)}\033[0m {badge}")
    if not args.no_web:
        print(f"  • URL:      \033[36m{core.base_url(f'{ws_id}.{name}.localhost')}\033[0m  (and /{name}/ on the dashboard host)")
        print(f"  • Upstream: \033[1m{ws_id}_{name}:{port}\033[0m (via om_router)")
    if not has_build(find_compose_file(dest)):
        lock_workspace(root, name, refresh=False)  # pinned from the start; commit .om/lock.json with the service
    print(f"\n  Run '\033[1mom start {name}\033[0m' to launch.")

def cmd_edit(root: Path, args):
    """Edit dashboard labels in-place (e.g. toggle public/private), recreate, and reload routes."""
    sname = args.service.lower().strip()
    dir_path = resolve_target(root, sname)
    compose_file = find_compose_file(dir_path)

    updates = {}
    if args.scope:
        updates["dashboard.scope"] = args.scope.lower()
    if args.port:
        updates["dashboard.port"] = str(args.port)
    if args.icon:
        updates["dashboard.icon"] = args.icon
    if args.desc:
        updates["dashboard.description"] = args.desc
    if args.name:
        updates["dashboard.name"] = args.name
    if not updates:
        die("No edits specified. Use --scope, --port, --icon, --desc, or --name.")
    if not all(yaml_label_safe(v) for v in updates.values()):
        die("Error: values must not contain quotes, backslashes or newlines")

    lines = compose_file.read_text(encoding="utf-8").splitlines()
    new_lines, in_labels, found_labels, handled = [], False, False, set()
    labels_indent = "      "
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("labels:"):
            in_labels = found_labels = True
            labels_indent = line[:len(line) - len(line.lstrip())] + "  "
            new_lines.append(line)
            continue
        if in_labels:
            if stripped.startswith("-") and any(f"{k}=" in stripped for k in updates):
                for k, v in updates.items():
                    if f"{k}=" in stripped:
                        new_lines.append(f'{labels_indent}- "{k}={v}"')
                        handled.add(k)
                        break
                continue
            if not stripped.startswith("-") and stripped and not stripped.startswith("#"):
                for k, v in updates.items():
                    if k not in handled:
                        new_lines.append(f'{labels_indent}- "{k}={v}"')
                        handled.add(k)
                in_labels = False
        new_lines.append(line)
    if found_labels:
        for k, v in updates.items():
            if k not in handled:
                new_lines.append(f'{labels_indent}- "{k}={v}"')
    else:
        final, inserted = [], False
        for line in new_lines:
            final.append(line)
            if not inserted and line.strip().startswith(("image:", "container_name:")):
                indent = line[:len(line) - len(line.lstrip())]
                final.append(f"{indent}labels:")
                final.extend(f'{indent}  - "{k}={v}"' for k, v in updates.items())
                inserted = True
        new_lines = final
    compose_file.write_text("\n".join(new_lines) + "\n", encoding="utf-8", newline="\n")

    print(f"\n\033[1m⚙️  Updated {sname}:\033[0m " + ", ".join(f"{k}={v}" for k, v in updates.items()))
    # Same path as `om start` (policy gate, egress, lock, secrets, its own network); a plain `compose up`
    # would recreate the container without om's overrides.
    if not start_workspace(root, dir_path.name, kind="edit"):
        sys.exit(1)
    print(f"\033[32m✓ {sname} updated; routes live.\033[0m\n")

def cmd_init(args):
    target_dir = Path.cwd().resolve()
    name = (args.name or target_dir.name).lower()
    if not is_valid_workspace_id(name):
        die(f"Error: invalid workspace id '{name}' (allowed: lowercase letters, digits, '-'; 'core' is reserved). "
            f"Pass one: om init <name>")
    if (target_dir / ".om" / "config.json").exists():
        print(f"\033[33mWorkspace already initialized at {target_dir}\033[0m")
        return
    if name in read_registry() and Path(read_registry()[name].get("path", "")).exists():
        die(f"Workspace id '{name}' is already used by {read_registry()[name]['path']}. Choose another: om init <name>")

    print(f"\033[1m🚀 Initializing workspace: {name}\033[0m")
    for d in ["services", "projects", "scripts", "data", "docs", ".om"]:
        (target_dir / d).mkdir(parents=True, exist_ok=True)
    write_ws_config(target_dir, {
        "workspace_id": name,
        "version": VERSION,
        "tracked_branch": "main",
        "gitops": {"auto_sync": False, "auto_rollback": True, "interval_seconds": 300},
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    })
    gitignore = target_dir / ".gitignore"
    if not gitignore.exists():
        gitignore.write_text("data/\n.om/trash/\n.om/state.json\n.om/local.json\n*.log\n.env\n.env.local\n__pycache__/\nnode_modules/\n.DS_Store\n", encoding="utf-8", newline="\n")
    signers = target_dir / generations.SIGNERS_NAME
    if not signers.exists():
        line = my_signer_line()
        if line:
            signers.write_text(line + "\n", encoding="utf-8", newline="\n")
            print(f"  ✓ {generations.SIGNERS_NAME}: your git signing key may deploy this workspace")
        else:
            print(f"  \033[33m⚠ git has no SSH signing key (gpg.format=ssh, user.signingkey): deploys stay unsigned until you add one to {generations.SIGNERS_NAME}\033[0m")
    register_workspace(target_dir, name)
    ensure_workspace_network(name, detect_runtime())
    print(f"\033[32m✓ Workspace ready at {target_dir}\033[0m")
    print("  Next: '\033[1mom add <service>\033[0m' then '\033[1mom start\033[0m'.")


# ── GitOps ──────────────────────────────────────────────────────────────────


def tracked_branch(root: Path) -> str:
    b = read_ws_config(root).get("tracked_branch", "main")
    return b if re.fullmatch(r"[A-Za-z0-9._/-]{1,100}", b) and not b.startswith("-") else "main"

def sync_allowed(root: Path, rev: str) -> bool:
    """Gate for `om sync`: the incoming commit must be signed by a trusted key (OM_SIGNED)."""
    trusted, who = generations.verify(get_workspace_id(root), root, rev)
    if trusted:
        print(f"  \033[32m✓ incoming {rev} signed by {who}\033[0m")
        return True
    if generations.mode() == "enforce":
        print(f"  \033[31m✗ incoming {rev}: {who}. Not pulled (OM_SIGNED=enforce).\033[0m")
        return False
    print(f"  \033[33m⚠ incoming {rev}: {who} (OM_SIGNED=warn: syncing anyway).\033[0m")
    return True

def cmd_sync(root: Path | None, args):
    if args.scheduled:
        sys.exit(scheduled_sync())
    if not root:
        die("fatal: not an om workspace. cd into one, or use `om sync --scheduled`.")
    ok = sync_workspace(root, branch=tracked_branch(root), force=args.force, rebase=args.rebase,
                        reconcile=lambda kind: start_workspace(root, build=True, kind=kind),
                        verify=lambda rev: sync_allowed(root, rev))
    sys.exit(0 if ok else 1)

AUTO_UPDATE_EVERY = 6 * 3600

def cmd_scan(root: Path):
    """Count critical and high vulnerabilities in every image pinned in .om/lock.json (trivy or grype)."""
    tool = scan.scanner()
    if not tool:
        die("No scanner found. Install trivy or grype; om ships none (the vulnerability database is theirs).")
    pinned = lock.read(root)
    if not pinned:
        die("Nothing pinned yet: run `om lock` first.")
    for ref, digest in sorted(pinned.items()):
        print(f"  {ref} ...", end=" ", flush=True)
        r = run(scan.command(tool, lock.pinned_ref(ref, digest)))
        try:
            counts = scan.count(tool, r.stdout)
        except ValueError:
            print(f"\033[33m⚠ {tool} failed: {(r.stderr or r.stdout).strip()[-200:]}\033[0m")
            continue
        bad = any(counts.values())
        print(("\033[31m" if bad else "\033[32m") + ", ".join(f"{n} {s.lower()}" for s, n in counts.items()) + "\033[0m")
    print(f"  ({tool}; a pin with findings may have a fix: om update --dry-run)")

def cmd_prune(args):
    """List (or, with --yes, remove) images no container uses and no workspace lock pins."""
    runtime = detect_runtime()
    locked = set()
    for d in read_registry().values():
        locked |= set(lock.read(Path(d.get("path", ""))).values())
    found = prune.candidates(runtime, locked)
    if not found:
        print("  No unused images.")
        return
    for e in found:
        print(f"  {', '.join(e['names']) or '<untagged>':<56} {e['id']}  {e['size'] / 1e6:8.1f} MB")
    total = sum(e["size"] for e in found) / 1e6
    if not args.yes:
        print(f"  {len(found)} unused image(s), at most {total:.0f} MB (layers shared between images are counted once each). "
              "Remove them: om prune --yes   (images of any project on this engine, not only om's)")
        return
    kept = [e["id"] for e in found if not prune.remove(runtime, e)]
    print(f"\033[32m✓ Removed {len(found) - len(kept)} image(s).\033[0m" + (f" \033[33mkept (engine refused): {', '.join(kept)}\033[0m" if kept else ""))

def cmd_notify():
    """Send a test message on every channel in OM_NOTIFY and say what each one did."""
    chans = notify.channels()
    print(f"  Channels (OM_NOTIFY): {', '.join(chans) or 'none'}; every message is also appended to {notify.LOG}")
    for name, ok, detail in notify.notify("om: test", "If you can read this, notifications work."):
        mark = "\033[32m✓\033[0m" if ok else "\033[31m✗\033[0m"
        print(f"  {mark} {name}: {detail}")
    if not chans:
        print(f"  Notifications are off (OM_NOTIFY=off). Set OM_NOTIFY=auto, or add webhook with OM_NOTIFY_URL=https://ntfy.sh/<topic>, in {core.USER_ENV}")

def auto_update(root: Path, state: dict) -> list:
    """Move the images only om.update=auto services use to their newest digests, redeploy, and undo it
    (revert the lock commit, redeploy) if the health check fails. A digest that failed is not retried.
    Returns log lines."""
    ws_id = get_workspace_id(root)
    _, _, auto = workspace_images(root, None)
    failed = state.setdefault("auto_failed", {})
    ups = {ref: d for ref, d in available_updates(root).items() if ref in auto and failed.get(ref) != d[1]}
    if not ups:
        return []
    old_lock = lock.read(root)
    old, new = lock_workspace(root, None, refresh=True, only=set(ups))
    moved = sorted(ref for ref in ups if old.get(ref) != new.get(ref))
    if not moved:
        return []
    commit_lock(root, "om update (auto): " + ", ".join(moved))
    if run_git(["status", "--porcelain", "--", lock.LOCK_NAME], root)[1].strip():
        lock.write(root, old_lock)
        return ["auto-update aborted: could not commit .om/lock.json, pins restored"]
    names = ", ".join(f"{ref} {old[ref][7:19] if ref in old else 'unpinned'} → {new[ref][7:19]}" for ref in moved)
    if start_workspace(root, None, kind="update") and run_synthetic_health_check(workspace_vhosts(ws_id)):
        for ref in moved:
            failed.pop(ref, None)
        return [f"auto-updated {names}"]
    failed.update({ref: new[ref] for ref in moved})
    if run_git(["revert", "--no-edit", "HEAD"], root)[0] != 0:
        lock.write(root, old_lock)
        return [f"auto-update of {names} FAILED its health check; could not revert the lock commit, pins restored in the working tree"]
    redeployed = start_workspace(root, None, kind="rollback")
    return [f"auto-update of {names} FAILED its health check; lock reverted" + ("" if redeployed else ", redeploy of the previous images FAILED too")]

def scheduled_sync() -> int:
    """Run `om sync` for every workspace with gitops.auto_sync enabled whose interval has elapsed."""
    log_dir = core.LOG_DIR
    log_dir.mkdir(exist_ok=True)
    rc = 0
    with open(log_dir / "autosync.log", "a", encoding="utf-8") as log:
        def emit(msg):
            log.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")
            log.flush()
        for ws_id, data in sorted(read_registry().items()):
            root = Path(data.get("path", ""))
            if not root.exists():
                continue
            g = gitops_settings(root)
            if not g.get("auto_sync"):
                continue
            hide_local_files(root)
            state_file = root / ".om" / "state.json"
            try:
                state = json.loads(state_file.read_text(encoding="utf-8"))
            except Exception:
                state = {}
            if time.time() - state.get("last_sync", 0) < max(60, int(g.get("interval_seconds", 300))):
                continue
            state["last_sync"] = int(time.time())
            branch = tracked_branch(root)

            def git(*a, root=root):
                return run(["git", *a], cwd=root).stdout.strip()

            if git("status", "--porcelain"):
                emit(f"{ws_id}: skipped — uncommitted changes in {root}")
                state["last_result"] = "skipped (dirty)"
                state_file.write_text(json.dumps(state), encoding="utf-8", newline="\n")
                continue
            git("fetch", "-q", "origin", branch)
            remote = git("rev-parse", "--verify", "-q", f"origin/{branch}")
            if remote and remote == state.get("quarantined"):
                # This remote commit already failed its health check and was rolled back;
                # don't redeploy it every interval. A new push clears the quarantine.
                state["last_result"] = f"skipped (remote {remote[:8]} quarantined)"
                state_file.write_text(json.dumps(state), encoding="utf-8", newline="\n")
                continue

            emit(f"{ws_id}: syncing")
            import contextlib
            import io
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                ok = sync_workspace(root, branch=branch, reconcile=lambda kind, r=root: start_workspace(r, build=True, kind=kind),
                                    verify=lambda rev, r=root: sync_allowed(r, rev))
            for line in buf.getvalue().splitlines():
                emit(f"{ws_id}: {_AnsiStripper._re.sub('', line)}")
            if ok:
                state.pop("quarantined", None)
            elif remote and git("rev-parse", "HEAD") != remote:
                state["quarantined"] = remote
                emit(f"{ws_id}: remote {remote[:8]} quarantined until a new commit is pushed")
            if not ok:  # once per failing remote commit
                notify.notify(f"om: {ws_id}", f"sync of {branch} failed" + (f"; remote {remote[:8]} is quarantined until a new commit is pushed"
                              if remote and state.get("quarantined") == remote else "") + f" (see {log_dir / 'autosync.log'})",
                              key=f"sync:{ws_id}:{remote or 'local'}")
            state["last_result"] = "ok" if ok else "failed"
            if ok and time.time() - state.get("last_auto_update", 0) >= AUTO_UPDATE_EVERY:
                state["last_auto_update"] = int(time.time())
                with contextlib.redirect_stdout(io.StringIO()):
                    lines = auto_update(root, state)
                for line in lines:
                    emit(f"{ws_id}: {line}")
                    notify.notify(f"om: {ws_id}", line, key=f"auto:{ws_id}:{line}")
                if any("FAILED" in line or "aborted" in line for line in lines):
                    state["last_result"] = "auto-update failed"
            state_file.write_text(json.dumps(state), encoding="utf-8", newline="\n")
            rc |= 0 if ok else 1
    return rc

def cmd_autosync(root: Path | None, args):
    if args.action == "status":
        print(f"  Scheduler: {hostsetup.autosync_status()}")
        for ws_id, data in sorted(read_registry().items()):
            r = Path(data.get("path", ""))
            g = gitops_settings(r) if r.exists() else {}
            try:
                st = json.loads((r / ".om" / "state.json").read_text(encoding="utf-8"))
                last = time.strftime("%Y-%m-%d %H:%M", time.localtime(st["last_sync"])) + f" ({st.get('last_result')})"
            except Exception:
                last = "never"
            print(f"  {ws_id:<20} auto_sync={'on ' if g.get('auto_sync') else 'off'} every {g.get('interval_seconds', 300)}s  last: {last}")
        print(f"  Log: {core.LOG_DIR / 'autosync.log'}")
        return
    if not root:
        die("Run inside a workspace: `om autosync on|off` applies to the current workspace.")
    local = read_local(root)
    g = local.setdefault("gitops", {})
    if args.action == "on":
        if not (root / ".git").exists():
            die("This workspace is not a git repository (git init && git remote add origin <url>).")
        g["auto_sync"] = True
        if args.every:
            g["interval_seconds"] = max(60, args.every * 60)
        write_local(root, local)
        if hostsetup.autosync_status() != "active":
            hostsetup.autosync_enable()
        print(f"\033[32m✓ Auto-sync on for {get_workspace_id(root)} on this machine "
              f"(every {gitops_settings(root)['interval_seconds']}s).\033[0m")
    else:
        g["auto_sync"] = False
        write_local(root, local)
        still = any(gitops_settings(Path(d["path"])).get("auto_sync")
                    for d in read_registry().values() if Path(d.get("path", "")).exists())
        if not still:
            hostsetup.autosync_disable()
        print(f"\033[32m✓ Auto-sync off for {get_workspace_id(root)}.\033[0m")


# ── Security & host integration ─────────────────────────────────────────────


def cmd_preview(root: Path, args):
    """A branch as its own throw-away workspace: a git worktree with its own id, network, data
    and ports, next to the original (`om preview <branch>`, `om preview rm <branch>`)."""
    base = read_local(root).get("preview_of") or get_workspace_id(root)
    origin = Path(read_registry().get(base, {}).get("path", root))
    if args.action == "list" or not args.branch:
        mine = {w: d for w, d in read_registry().items() if w.startswith(f"{base}--")}
        print(f"\n\033[1mPREVIEWS of {base}\033[0m")
        if not mine:
            print("  None. `om preview <branch>` runs a branch next to this workspace.\n")
            return
        for w, d in sorted(mine.items()):
            branch = run(["git", "-C", d.get("path", ""), "branch", "--show-current"]).stdout.strip() or "?"
            print(f"  {w:<36} branch {branch:<24} {d.get('path', '')}")
        print()
        return
    pid = preview_id(base, args.branch)
    path = PREVIEWS_DIR / pid
    runtime = detect_runtime()
    if args.action == "rm":
        if not path.exists() and pid not in read_registry():
            die(f"No preview {pid}.")
        if path.exists():
            env = get_workspace_env(path, pid, runtime)
            for _, d in reversed(discover_compose_dirs(path, None)):
                run(compose(runtime, find_compose_file(d), "down", "-v"), cwd=d, env=env)
        agesecrets.wipe(pid)
        egress.render_workspace(runtime, pid, {}, prune=True)
        update_registry(lambda reg: reg.pop(pid, None))
        for f in CONF_D.glob(f"{pid}-*"):
            if route_owner(f) == pid:
                f.unlink()
        core.release_slots(pid)
        reload_caddy(runtime, quiet=True)
        for c in (core.ROUTER, core.EGRESS):  # attached to every workspace network
            run([runtime, "network", "disconnect", f"{pid}_net", c])
        run([runtime, "network", "rm", f"{pid}_net"])
        prune_project_networks(runtime, pid, set())
        core.set_egress_networks(pid, None)
        shutil.rmtree(core.STATE_DIR / "generations" / pid, ignore_errors=True)
        r = run(["git", "-C", str(origin), "worktree", "remove", "--force", str(path)])
        if r.returncode != 0:
            shutil.rmtree(path, ignore_errors=True)
            run(["git", "-C", str(origin), "worktree", "prune"])
        links.sync(runtime)
        print(f"\033[32m✓ Preview {pid} removed\033[0m: containers, data, routes, ports and worktree."
              f" The branch {args.branch} is kept (git branch -D {args.branch} to delete it).")
        return
    if not path.exists():
        if run(["git", "-C", str(origin), "rev-parse", "--is-inside-work-tree"]).returncode != 0:
            die("Previews need the workspace to be a git repository (git init).")
        if run(["git", "-C", str(origin), "branch", "--show-current"]).stdout.strip() == args.branch:
            die(f"{args.branch} is checked out here already — `om start` runs it.")
        exists = run(["git", "-C", str(origin), "rev-parse", "--verify", "--quiet", f"refs/heads/{args.branch}"]).returncode == 0
        PREVIEWS_DIR.mkdir(parents=True, exist_ok=True)
        cmd = ["worktree", "add", str(path), args.branch] if exists else ["worktree", "add", "-b", args.branch, str(path)]
        r = run(["git", "-C", str(origin), *cmd])
        if r.returncode != 0:
            die(f"git worktree failed: {(r.stderr or r.stdout).strip()[-300:]}")
        write_local(path, {"workspace_id": pid, "preview_of": base})
        print(f"\033[32m✓ {args.branch} checked out as preview {pid}\033[0m"
              + ("" if exists else f" (new branch from {run(['git', '-C', str(origin), 'branch', '--show-current']).stdout.strip() or 'HEAD'})"))
    bad = preview_portable(path)
    if bad:
        die("These names would collide with the original workspace; use the variables om sets:\n  " + "\n  ".join(bad))
    register_workspace(path, pid)
    if not start_workspace(path, kind="preview"):
        die(f"The preview did not start cleanly; `om preview rm {args.branch}` throws it away.")
    cmd_routes(path, args)
    print(f"  Throw it away: om preview rm {args.branch}\n")


def cmd_doctor(root, args):
    sys.exit(doctor.run_doctor(detect_runtime(), as_json=getattr(args, "json", False)))

def cmd_uninstall(root, args):
    runtime = detect_runtime()
    if not args.yes and not confirm("Stop the Global Core and uninstall om? (workspaces are not touched)"):
        die("Aborted.")
    core.core_down(runtime)
    hostsetup.autosync_disable()
    hostsetup.boot_disable()
    for link in (Path.home() / ".local" / "bin" / "om", Path.home() / ".local" / "bin" / "om.cmd"):
        if link.is_symlink() and link.resolve() == (OM_HOME / "bin" / "om").resolve() or link.is_file() and "om-wrapper" in link.read_text(errors="ignore", encoding="utf-8"):
            link.unlink()
    print("\033[32m✓ om stopped and unlinked.\033[0m")
    print("  Host firewall (if applied) stays active: `om firewall remove` before uninstalling to drop it.")
    if args.purge:
        targets = [p for p in (OM_HOME, core.STATE_DIR) if p.exists()]
        shown = ", ".join(str(p) for p in targets + [core.USER_ENV])
        if input(f"Type 'delete' to permanently delete {shown} (program, local CA, routes, settings): ").strip() == "delete":
            for p in targets:
                shutil.rmtree(p, ignore_errors=True)
            core.USER_ENV.unlink(missing_ok=True)
            try:
                core.CONFIG_DIR.rmdir()  # only if empty: the folder may be shared with other tools
            except OSError:
                pass
            print(f"\033[32m✓ Deleted {shown}\033[0m")


# ── CLI ─────────────────────────────────────────────────────────────────────

def ensure_state_migrated():
    """One-time move of pre-split state out of OM_HOME (see gitops.core). The edge bind-mounts
    that state, so a running core is stopped first and brought back on the new paths."""
    if not core.legacy_state_present():
        return
    with core.file_lock(core.STATE_DIR / "migrate.lock"):
        if not core.legacy_state_present():
            return
        runtime = detect_runtime()
        was_running = any(core.container_running(runtime, c) for c in core.CORE_CONTAINERS)
        print(f"\033[1m📦 Moving om state out of {OM_HOME}\033[0m (one time)\n"
              f"  settings → {core.USER_ENV}\n  state    → {core.STATE_DIR}")
        if was_running:
            # Not core_down(): that would mint fresh state at the new paths before the old moves.
            run([runtime, "stop", *core.CORE_CONTAINERS])
        for line in core.migrate_legacy_state():
            print(f"  \033[36m{line}\033[0m")
        if was_running:
            if core.core_up(runtime, recreate=True, quiet=True):
                prune_orphan_routes(runtime)
                print("  \033[32m✓ Global Core restarted on the new paths.\033[0m")
            else:
                print("  \033[31m✗ Core did not come back; run `om doctor`.\033[0m")

ROOT_REFUSAL = """om does not run as root (sudo).
  Containers run rootless under your own user: a service that escapes its container lands as
  an ordinary user, not as root. Under sudo om would use root's container engine, root's state
  and root's containers — a second, separate om whose files your user cannot change.
  Run `om` as yourself. The few host steps that need root (om firewall, om boot, the installer's
  port setting) ask for sudo themselves."""

def cmd_reload(root: Path, args):
    runtime = detect_runtime()
    sync_caddy_routes(root, runtime, reload=False)
    reload_caddy(runtime=runtime, workspace_id=get_workspace_id(root))

def cmd_restart(root: Path, args):
    cmd_stop(root, args)
    cmd_start(root, args)

def cmd_drift(root: Path, args):
    print_drift_report(root, tracked_branch(root))

def cmd_preview_dispatch(root: Path, args):
    """`om preview <branch>` is `start <branch>`; with no branch it lists."""
    if args.action not in ("start", "rm", "list"):
        args.action, args.branch = "start", args.action
    if args.action == "start" and not args.branch:
        args.action = "list"
    cmd_preview(root, args)

def global_commands(root: Path | None, args, parser) -> dict:
    """Commands that work anywhere (no workspace needed): name -> what to run. Looked up at call time."""
    return {
        "init": lambda: cmd_init(args), "list": lambda: cmd_list(args), "ports": lambda: cmd_ports(args),
        "core": lambda: cmd_core(root, args), "doctor": lambda: cmd_doctor(root, args),
        "auth": lambda: cmd_auth(root, args), "firewall": lambda: cmd_firewall(root, args),
        "boot": lambda: cmd_boot(root, args), "secrets": lambda: cmd_secrets(root, args),
        "vpn": lambda: cmd_vpn(root, args), "links": lambda: cmd_links(root, args),
        "notify": cmd_notify, "prune": lambda: cmd_prune(args),
        "completion": lambda: cmd_completion(parser, args.shell), "uninstall": lambda: cmd_uninstall(root, args),
        "version": lambda: print(f"om {VERSION}"), "sync": lambda: cmd_sync(root, args),
        "autosync": lambda: cmd_autosync(root, args), "docs": lambda: cmd_docs(args),
        "policy": lambda: cmd_policy(root, args), "egress": lambda: cmd_egress(root, args),
    }

def workspace_commands() -> dict:
    """Commands that need a workspace: name -> function(root, args). Looked up at call time."""
    return {
        "down": cmd_down, "start": cmd_start, "stop": cmd_stop, "restart": cmd_restart, "update": cmd_update,
        "edit": cmd_edit, "dev": cmd_dev, "scripts": cmd_scripts, "script": cmd_scripts, "add": cmd_add,
        "remove": cmd_remove, "rm": cmd_remove, "disable": cmd_disable, "enable": cmd_enable, "logs": cmd_logs,
        "shell": cmd_shell, "run": cmd_run, "reload": cmd_reload, "routes": cmd_routes, "network": cmd_network,
        "lock": cmd_lock, "log": cmd_log, "rollback": cmd_rollback, "fsck": cmd_fsck,
        "scan": lambda root, args: cmd_scan(root), "drift": cmd_drift, "preview": cmd_preview_dispatch,
    }

def main():
    if hasattr(os, "geteuid") and os.geteuid() == 0:
        die(ROOT_REFUSAL)
    parser = build_parser()
    args = parser.parse_args()
    if args.command not in ("version", "completion", "uninstall"):
        ensure_state_migrated()
    root = find_workspace_root()
    cmd = args.command

    run_global = global_commands(root, args, parser).get(cmd)
    if run_global:
        run_global()
    elif cmd in (None, "status"):
        cmd_status(root, args)
    elif not root:
        die("fatal: not an om workspace (or any parent directory).\n"
            "Run 'om init [name]' here, or cd into an existing workspace (see `om list`).")
    else:
        workspace_commands()[cmd](root, args)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)

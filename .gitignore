.aider*

# Python bytecode
__pycache__/
*.pyc

# Legacy (pre-split) state locations. om now keeps settings in ~/.config/om/om.env and
# state in ~/.local/state/om/ and migrates these away once; kept so nothing slips into git.
# Machine-specific settings & generated runtime files
core/.env
core/.runtime.env
core/ports.generated.yml
core/firewall/

# Runtime state: Caddy PKI (root CA + private keys), edge↔router token, dashboard data
core/data/

# Private-tier login (password hash)
core/caddy/auth.d/*
!core/caddy/auth.d/.keep

# Per-machine workspace registry & logs
config/
logs/

# Generated workspace routes (regenerated by `om start` / `om reload`); keep hand-written core routes
core/caddy/conf.d/*
!core/caddy/conf.d/00-info.caddy
!core/caddy/conf.d/portainer.caddy
!core/caddy/conf.d/portainer.private_subpath

# Leftovers parked by the state migration when newer state already existed
*.pre-migration

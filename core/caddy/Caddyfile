# om Edge Proxy (om_caddy) — the single front door.
# ==============================================================================
# Machine-specific values ({$...}) come from core/.runtime.env, generated by
# `om core start`. Disabled addresses are set to *.invalid names that never resolve.
#
# The edge sits only on om_core_net: no workspace container can reach it.
# Workspace services are reached through the internal router (om_router), which
# accepts only requests carrying the edge's secret token (see router/Caddyfile).
# ==============================================================================

{
    admin 127.0.0.1:2019
    auto_https disable_redirects
    # Read-only container: don't try to install the local CA into the container's trust store
    skip_install_trust
    # TLS clients that send no SNI (e.g. https://<LAN IP>/) get the LAN IP's certificate
    default_sni {$LAN_IP}
    log {
        output stdout
        format console
    }
    # No trusted_proxies: the edge replaces client-supplied X-Forwarded-* headers.
    servers {
        timeouts {
            read_body 30s
            read_header 10s
            write 60s
            idle 120s
        }
        max_header_size 1MB
    }
}

(security_headers) {
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
    request_body {
        max_size 25MB
    }
}

# Optional login for the whole private tier (`om auth set <user>`): auth.d/ holds a
# basic_auth block, or nothing when auth is off.
(private_auth) {
    import /etc/caddy/auth.d/*.conf
}

# Hand a request to a workspace service via the router. Usage: import to_workspace <ws>_<svc>:<port>
# header_up *sets* both headers, so anything a client sent under these names is discarded.
(to_workspace) {
    reverse_proxy om_router:8000 {
        header_up X-Om-Edge-Token {$OM_EDGE_TOKEN}
        header_up X-Om-Upstream {args[0]}
    }
}

(to_dashboard) {
    reverse_proxy dashboard:80 {
        lb_try_duration 2s
        lb_try_interval 200ms
    }
}

# ==============================================================================
# 1. PRIVATE INGRESS (container :80/:443 ← host loopback, Tailscale, and devices through the door)
# ==============================================================================
# Hosts are listed explicitly (no catch-all) so DNS-rebinding requests carrying a
# foreign Host header fall through to the abort blocks at the end.
http://localhost, http://127.0.0.1, http://[::1], http://dashboard.localhost, http://*.dashboard.localhost, http://{$TAILSCALE_SHORT}, http://{$TAILSCALE_HOST}, http://{$TAILSCALE_IP}, http://{$DOOR_IP} {
    import security_headers
    import private_auth

    # Private ingress serves both private and public subpaths (full view for the owner).
    import /etc/caddy/core.d/*.private_subpath
    import /etc/caddy/core.d/*.public_subpath
    import /etc/caddy/conf.d/*.private_subpath
    import /etc/caddy/conf.d/*.public_subpath

    handle {
        import to_dashboard
    }
}

https://localhost, https://dashboard.localhost, https://*.dashboard.localhost, https://{$TAILSCALE_HOST}, https://{$TAILSCALE_IP}, https://{$DOOR_IP} {
    import security_headers
    import private_auth
    header Strict-Transport-Security "max-age=31536000"
    tls internal

    import /etc/caddy/core.d/*.private_subpath
    import /etc/caddy/core.d/*.public_subpath
    import /etc/caddy/conf.d/*.private_subpath
    import /etc/caddy/conf.d/*.public_subpath

    handle {
        import to_dashboard
    }
}

# ==============================================================================
# 2. PUBLIC INGRESS (container :8080/:8443 ← host LAN address only)
# ==============================================================================
# Only public subpaths exist here. Private services have no route on these ports.
:8080 {
    import security_headers

    import /etc/caddy/core.d/*.public_subpath
    import /etc/caddy/conf.d/*.public_subpath

    handle {
        reverse_proxy dashboard:80 {
            header_up X-Access-Scope public
            lb_try_duration 2s
            lb_try_interval 200ms
        }
    }
}

https://{$LAN_IP}:8443 {
    import security_headers
    tls internal

    import /etc/caddy/core.d/*.public_subpath
    import /etc/caddy/conf.d/*.public_subpath

    handle {
        reverse_proxy dashboard:80 {
            header_up X-Access-Scope public
            lb_try_duration 2s
            lb_try_interval 200ms
        }
    }
}

# ==============================================================================
# 3. WORKSPACE SERVICE ROUTES (generated <ws>-<svc>.caddy, private tier)
# ==============================================================================
# core.d: om's own routes (OM_HOME); conf.d: generated workspace routes (OM_STATE_DIR)
import /etc/caddy/core.d/*.caddy
import /etc/caddy/conf.d/*.caddy

# ==============================================================================
# 4. CATCH-ALLS — any other Host/SNI is dropped
# ==============================================================================
:80 {
    abort
}

:443 {
    tls internal
    abort
}

:8443 {
    tls internal
    abort
}

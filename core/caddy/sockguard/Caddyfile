# om_sockguard: read-only filter in front of the container engine socket.
# The dashboard reaches the engine only through the unix socket below, and only for
# listing containers and reading their stats. Everything else (create, exec, kill, …) is 403.
{
	admin off
	auto_https off
	persist_config off
}

http:// {
	bind unix//run/om-engine/engine.sock
	@read {
		method GET
		path_regexp ^/(v[0-9.]+/)?containers/(json|[A-Za-z0-9_.-]+/stats)$
	}
	handle @read {
		reverse_proxy unix//var/run/docker.sock
	}
	handle {
		respond 403
	}
}
